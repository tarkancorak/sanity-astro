---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import { siteConfig } from "../config/site";

/*
 * Homepage SKELETON.
 *
 * This is intentionally a blank canvas — the sections below are placeholders so
 * every client site gets its own layout and design instead of a shared look.
 * Build the real hero, services, references, etc. here. The only wired-up piece
 * is the contact section (form -> siteConfig.formEndpoint) and the shell
 * (header/footer via Layout).
 */
---

<Layout>
  <!-- HERO placeholder — replace with the real hero design -->
  <section class="mx-auto max-w-[1180px] px-6 py-24 text-center">
    <p class="text-sm font-semibold text-[var(--color-accent)]">{siteConfig.serviceArea}</p>
    <h1 class="mt-3 text-5xl font-extrabold tracking-tight">{siteConfig.company.name}</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-[var(--color-gray)]">{siteConfig.company.tagline}</p>
    <p class="mt-8 text-sm text-[var(--color-gray)]">
      (Startseiten-Gerüst — hier das individuelle Design der Kundensite aufbauen.)
    </p>
  </section>

  <!-- Add further sections here: Leistungen, Referenzen, Über uns, … -->

  <!-- CONTACT — wired to the central form endpoint -->
  <section id="kontakt" class="mx-auto max-w-[560px] px-6 py-20">
    <h2 class="text-center text-3xl font-extrabold">Kontakt</h2>
    <p class="mt-2 mb-8 text-center text-[var(--color-gray)]">
      Schreiben Sie uns – wir melden uns zeitnah zurück.
    </p>
    <ContactForm />
  </section>
</Layout>
