---
import LegalLayout from "../layouts/LegalLayout.astro";
import { siteConfig } from "../config/site";
---

<LegalLayout title={`Impressum | ${siteConfig.company.name}`}>
  <h1 class="text-[40px] font-extrabold" style="letter-spacing:-0.02em;">Impressum</h1>

  <div class="legal-notice mt-7">
    <strong>Hinweis für die Umsetzung:</strong> Gelb markierte Felder müssen vor dem Livegang mit den
    echten Angaben (Inhaber, Anschrift, ggf. USt-IdNr., Kammer/Handwerksrolle) gefüllt werden. Bitte
    rechtlich prüfen lassen.
  </div>

  <section class="mt-10">
    <h2 class="legal-h2">Angaben gemäß § 5 DDG</h2>
    <p class="legal-p">
      {siteConfig.company.name}<br />
      Inhaber: <span class="legal-todo">[TODO: Vor- und Nachname]</span><br />
      <span class="legal-todo">[TODO: Straße und Hausnummer]</span><br />
      <span class="legal-todo">[TODO: PLZ und Ort]</span>
    </p>
  </section>

  <section class="mt-8">
    <h2 class="legal-h2">Kontakt</h2>
    <p class="legal-p">
      Telefon: {siteConfig.phone.display}<br />
      E-Mail: <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
    </p>
  </section>

  <section class="mt-8">
    <h2 class="legal-h2">Umsatzsteuer</h2>
    <p class="legal-p">
      Umsatzsteuer-Identifikationsnummer gemäß § 27 a Umsatzsteuergesetz:<br />
      <span class="legal-todo">[TODO: USt-IdNr. — oder Hinweis auf Kleinunternehmerregelung § 19 UStG]</span>
    </p>
  </section>

  <section class="mt-8">
    <h2 class="legal-h2">Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
    <p class="legal-p">
      <span class="legal-todo">[TODO: Vor- und Nachname]</span><br />
      Anschrift wie oben
    </p>
  </section>

  <section class="mt-8">
    <h2 class="legal-h2">Verbraucherstreitbeilegung</h2>
    <p class="legal-p">
      Wir sind nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer
      Verbraucherschlichtungsstelle teilzunehmen.
    </p>
  </section>
</LegalLayout>
