---
import { siteConfig } from "../config/site";

/*
 * Contact form skeleton.
 *
 * Submission target is centralized in siteConfig.formEndpoint (see src/config/site.ts),
 * which points to the self-hosted PHP handler public/kontakt.php (SMTP, EU-only).
 * The client script POSTs FormData and, on success, swaps in a thank-you state;
 * on failure it shows an inline error message (no native re-submit fallback —
 * that would risk double sends and land the user on a raw JSON page).
 *
 * Styling is deliberately minimal — design it per client.
 */
---

<div class="contact-form-card">
  <form class="contact-form flex flex-col gap-4" action={siteConfig.formEndpoint} method="POST">
    <!-- Honeypot: füllen nur Bots aus — kontakt.php verwirft solche Einsendungen still. -->
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display: none;" />

    <div>
      <label for="name" class="block text-[13px] font-semibold">Name</label>
      <input id="name" name="name" type="text" required maxlength="100" class="form-field mt-1 w-full" />
    </div>

    <div>
      <label for="company" class="block text-[13px] font-semibold">
        Firma <span class="font-normal text-[var(--color-gray)]">(optional)</span>
      </label>
      <input id="company" name="company" type="text" maxlength="100" class="form-field mt-1 w-full" />
    </div>

    <div>
      <label for="telefon" class="block text-[13px] font-semibold">Telefon</label>
      <input id="telefon" name="telefon" type="tel" required maxlength="50" class="form-field mt-1 w-full" />
    </div>

    <div>
      <label for="email" class="block text-[13px] font-semibold">E-Mail</label>
      <input id="email" name="email" type="email" required maxlength="200" class="form-field mt-1 w-full" />
    </div>

    {siteConfig.topicField.options.length > 0 && (
      <div>
        <label for="topic" class="block text-[13px] font-semibold">
          {siteConfig.topicField.label} <span class="font-normal text-[var(--color-gray)]">(optional)</span>
        </label>
        <select id="topic" name="topic" class="form-field mt-1 w-full">
          <option value="" selected>Bitte wählen …</option>
          {siteConfig.topicField.options.map((opt) => <option value={opt}>{opt}</option>)}
        </select>
      </div>
    )}

    {siteConfig.sourceField.options.length > 0 && (
      <div>
        <label for="source" class="block text-[13px] font-semibold">
          {siteConfig.sourceField.label} <span class="font-normal text-[var(--color-gray)]">(optional)</span>
        </label>
        <select id="source" name="source" class="form-field mt-1 w-full">
          <option value="" selected>Bitte wählen …</option>
          {siteConfig.sourceField.options.map((opt) => <option value={opt}>{opt}</option>)}
        </select>
      </div>
    )}

    <div>
      <label for="message" class="block text-[13px] font-semibold">Ihr Anliegen</label>
      <textarea id="message" name="message" rows="5" required maxlength="5000" class="form-field mt-1 w-full resize-none"></textarea>
    </div>

    <button
      type="submit"
      class="rounded-[var(--radius-control)] bg-[var(--color-accent)] py-3 font-semibold text-white"
    >
      Anfrage senden
    </button>

    <p class="contact-form-error text-[13px] font-semibold text-red-600" hidden></p>

    <p class="text-[13px] text-[var(--color-gray)]">
      Hinweise zur Verarbeitung Ihrer Daten finden Sie in unserer
      <a href="/datenschutz" class="underline">Datenschutzerklärung</a>.
    </p>
  </form>

  <div class="contact-form-success flex-col items-center gap-2 py-10 text-center" hidden>
    <h3 class="text-[22px] font-extrabold">Vielen Dank!</h3>
    <p class="text-[15px] text-[var(--color-gray)]">
      Ihre Anfrage ist eingegangen. Wir melden uns zeitnah bei Ihnen.
    </p>
  </div>
</div>

<style>
  .form-field {
    background-color: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    padding: 0.6rem 0.8rem;
    font-family: var(--font-body);
  }
  .form-field:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  .contact-form-success:not([hidden]) {
    display: flex;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>(".contact-form");
  const successState = document.querySelector<HTMLElement>(".contact-form-success");
  const errorState = document.querySelector<HTMLElement>(".contact-form-error");
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    submitButton?.setAttribute("disabled", "");
    errorState?.setAttribute("hidden", "");

    let errorMessage =
      "Ihre Nachricht konnte nicht gesendet werden. Bitte versuchen Sie es später erneut oder schreiben Sie uns direkt per E-Mail.";

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      if (response.ok) {
        form.hidden = true;
        successState?.removeAttribute("hidden");
        return;
      }

      const data = await response.json().catch(() => null);
      if (data && typeof data.message === "string" && data.message !== "") {
        errorMessage = data.message;
      }
    } catch {
      // Netzwerkfehler: Meldung anzeigen. Kein natives Re-Submit — Doppelversand-Risiko.
    }

    if (errorState) {
      errorState.textContent = errorMessage;
      errorState.removeAttribute("hidden");
    }
    submitButton?.removeAttribute("disabled");
  });
</script>
