---
import Logo from "./Logo.astro";
import { siteConfig } from "../config/site";

/*
 * Skeleton footer: brand, nav, contact and legal links, wired to siteConfig.
 * Styling is deliberately minimal — design it per client.
 */
---

<footer class="mt-16 border-t border-[var(--color-border)]">
  <div class="mx-auto flex max-w-[1180px] flex-wrap items-start justify-between gap-8 px-6 py-10">
    <div>
      <Logo mode="light" height={20} />
      <p class="mt-3 max-w-xs text-[15px] text-[var(--color-gray)]">{siteConfig.company.tagline}</p>
    </div>

    <div>
      <p class="text-sm font-bold">Navigation</p>
      <nav class="mt-3 flex flex-col gap-2">
        {siteConfig.nav.map((link) => <a href={link.href} class="text-[15px]">{link.label}</a>)}
      </nav>
    </div>

    <div>
      <p class="text-sm font-bold">Kontakt</p>
      <div class="mt-3 flex flex-col gap-2 text-[15px]">
        <a href={`tel:${siteConfig.phone.link}`}>{siteConfig.phone.display}</a>
        <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        <span class="text-[var(--color-gray)]">{siteConfig.serviceArea}</span>
      </div>
    </div>
  </div>

  <div class="border-t border-[var(--color-border)]">
    <div class="mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-3 px-6 py-5 text-sm">
      <p>&copy; {siteConfig.company.year} {siteConfig.company.name}. Alle Rechte vorbehalten.</p>
      <div class="flex gap-5">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>
